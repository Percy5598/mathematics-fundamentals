   "source": [
    "# Percentage change \n",
    "old_price = 100\n",
    "new_price = 120\n",
    "\n",
    "absolute_change = new_price - old_price\n",
    "\n",
    "percentage_change = (\n",
    "    absolute_change / old_price\n",
    ") * 100\n",
    "\n",
    "print(f\"Absolute change: €{absolute_change}\")\n",
    "print(f\"Percentage change: {percentage_change:.2f}%\")"
   ]
  }
 ],
